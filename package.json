    "check:prompts": "node scripts/check-prompts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "~4.0.18",
    "canvas": "^3.2.3",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "vite": "^6.1.0",
    "vitest": "~4.0.18"
  }
}
